{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "isolatedModules": true,
    "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "types": ["vite/client"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
